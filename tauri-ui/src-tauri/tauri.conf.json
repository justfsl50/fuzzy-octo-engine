{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workspace Assistant",
  "version": "0.1.0",
  "identifier": "com.example.workspaceassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Workspace Assistant",
        "label": "main",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
